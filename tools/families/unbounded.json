        "master_overrides": {
          "wght=1": {
            "_comment": "design review 2026-10-13, Black variant B",
            "angle": 15,
            "thickness": 120,
            "x_span": 540,
            "gap_bottom": 24,
            "gap_between": 52
          }
        }
      },
      "otl_base": null,
      "kern_like": {
        "_comment": "Latin T's kerning against digits and punctuation only (no letters); T4 (-112/-80) would let the 4 run into the strokes, so it is capped.",
        "glyph": "T",
        "caps": {
          "four": {
            "_comment": "400/900 from the 2026-10-13 review; 200 chosen so the ₮-4 clearance equals the reviewed Regular's (122 units; uncapped T4 -124 would leave 96)",
            "wght=-1": -98,
            "default": -60,
            "wght=1": -40
          }
        }
      }
    }
  },
  "release_notes": [
    "Ү: kerning now derived from Latin Y through Latin look-alikes of each Cyrillic partner (Unbounded keeps Latin and Cyrillic kerning separate); partners without a look-alike, and ҮА / Ү. / Ү, keep the У values.",
    "₮: Black master redrawn per design review (strokes 120 thick, x 150..690, 15 deg, gaps 24/52/51); ExtraLight and Regular masters unchanged.",
    "₮: kerning from Latin T against digits and punctuation only; ₮4 capped at -98/-60/-40 (wght 200/400/900).",
    "Ү and ү: mark anchors now from Y and v.",
    "Ө, ө, ү outlines unchanged."
  ],
